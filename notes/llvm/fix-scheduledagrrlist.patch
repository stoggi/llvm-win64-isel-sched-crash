diff --git a/llvm/lib/CodeGen/SelectionDAG/ScheduleDAGRRList.cpp b/llvm/lib/CodeGen/SelectionDAG/ScheduleDAGRRList.cpp
index 5ea69ea78d43..fe66abf86c9e 100644
--- a/llvm/lib/CodeGen/SelectionDAG/ScheduleDAGRRList.cpp
+++ b/llvm/lib/CodeGen/SelectionDAG/ScheduleDAGRRList.cpp
@@ -1501,7 +1501,17 @@ SUnit *ScheduleDAGRRList::PickNodeToScheduleBottomUp() {
     // values to break the dependency. In case even that doesn't work,
     // insert cross class copies.
     // If it's not too expensive, i.e. cost != -1, issue copies.
-    SUnit *TrySU = Interferences[0];
+    //
+    // The call sequence resource is not a register and cannot be copied; a
+    // node waiting on it is unblocked by scheduling the call sequence that
+    // holds it. Resolve an interference on a real register instead.
+    unsigned CallResource = TRI->getNumRegs();
+    auto TryIt = find_if(Interferences, [&](SUnit *SU) {
+      return !is_contained(LRegsMap[SU], CallResource);
+    });
+    if (TryIt == Interferences.end())
+      report_fatal_error("Can't resolve call sequence interference!");
+    SUnit *TrySU = *TryIt;
     SmallVectorImpl<unsigned> &LRegs = LRegsMap[TrySU];
     assert(LRegs.size() == 1 && "Can't handle this yet!");
     unsigned Reg = LRegs[0];
diff --git a/llvm/test/CodeGen/X86/pre-ra-sched-callseq-interference.ll b/llvm/test/CodeGen/X86/pre-ra-sched-callseq-interference.ll
new file mode 100644
index 000000000000..07f6f1506e0f
--- /dev/null
+++ b/llvm/test/CodeGen/X86/pre-ra-sched-callseq-interference.ll
@@ -0,0 +1,53 @@
+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
+; RUN: llc < %s -mtriple=x86_64-pc-windows-msvc | FileCheck %s
+
+; The i1 argument is passed on the stack under Win64 and stored with SETCCm
+; inside the outer call sequence, but its EFLAGS come from a compare whose
+; folded load is chained before ADJCALLSTACKDOWN, which clobbers EFLAGS. The
+; FSIN libcall is chained only to the entry token, so it also waits on the
+; call sequence resource. The bottom-up list scheduler used to pick that
+; call resource interference in its last-resort path and ask for its register
+; class, asserting (or crashing in release builds); it must resolve the
+; EFLAGS interference instead.
+
+declare void @callee(ptr, ptr, ptr, float, i1)
+declare float @llvm.sin.f32(float)
+
+define void @repro(ptr %p, i1 %c, float %x, float %y, ptr %a, ptr %b, ptr %d) nounwind {
+; CHECK-LABEL: repro:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:    pushq %rsi
+; CHECK-NEXT:    pushq %rbx
+; CHECK-NEXT:    subq $72, %rsp
+; CHECK-NEXT:    movaps %xmm6, {{[-0-9]+}}(%r{{[sb]}}p) # 16-byte Spill
+; CHECK-NEXT:    movaps %xmm3, %xmm0
+; CHECK-NEXT:    movaps %xmm2, %xmm6
+; CHECK-NEXT:    movl %edx, %ebx
+; CHECK-NEXT:    movq (%rcx), %rsi
+; CHECK-NEXT:    callq sinf
+; CHECK-NEXT:    testq %rsi, %rsi
+; CHECK-NEXT:    movq {{[0-9]+}}(%rsp), %r8
+; CHECK-NEXT:    movq {{[0-9]+}}(%rsp), %rdx
+; CHECK-NEXT:    movq {{[0-9]+}}(%rsp), %rcx
+; CHECK-NEXT:    setne {{[0-9]+}}(%rsp)
+; CHECK-NEXT:    testb $1, %bl
+; CHECK-NEXT:    je .LBB0_2
+; CHECK-NEXT:  # %bb.1:
+; CHECK-NEXT:    movss {{.*#+}} xmm6 = [8.00000011E-1,0.0E+0,0.0E+0,0.0E+0]
+; CHECK-NEXT:  .LBB0_2:
+; CHECK-NEXT:    addss %xmm6, %xmm0
+; CHECK-NEXT:    movaps %xmm0, %xmm3
+; CHECK-NEXT:    callq callee
+; CHECK-NEXT:    movaps {{[-0-9]+}}(%r{{[sb]}}p), %xmm6 # 16-byte Reload
+; CHECK-NEXT:    addq $72, %rsp
+; CHECK-NEXT:    popq %rbx
+; CHECK-NEXT:    popq %rsi
+; CHECK-NEXT:    retq
+  %v = load i64, ptr %p, align 8
+  %flag = icmp ne i64 %v, 0
+  %sel = select i1 %c, float 0x3FE99999A0000000, float %x
+  %s = tail call float @llvm.sin.f32(float %y)
+  %sum = fadd float %s, %sel
+  call void @callee(ptr %a, ptr %b, ptr %d, float %sum, i1 %flag)
+  ret void
+}
